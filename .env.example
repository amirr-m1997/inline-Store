# Database (used by docker-compose and backend/config/settings.py).
# When POSTGRES_DB is set, the backend connects to PostgreSQL at POSTGRES_HOST.
# Leave unset for the zero-config SQLite local database (backend/db.sqlite3).
POSTGRES_DB=company_store
POSTGRES_USER=store
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Optional: use an in-memory SQLite database for isolated verification (SQLITE_PATH=:memory:).
SQLITE_PATH=

# Django security (must be set for production):
# - SECRET_KEY: required when DEBUG=False (the server refuses to start with the dev default).
# - DEBUG: defaults to False when unset. Set True explicitly for local development only.
# - ALLOWED_HOSTS: comma-separated public hostnames of the site.
# - CSRF_TRUSTED_ORIGINS: comma-separated origins (scheme://host) that may send
#   state-changing requests with the auth cookie — set to your public site origin.
# - CORS_ALLOWED_ORIGINS: origins allowed credentialed API access (public frontend origin in prod).
# - PAYMENTS_MOCK_ENABLED: when True the mock gateway lets orders be "paid"
#   without a real payment (development only). The server refuses to start with
#   it enabled when DEBUG=False.
# - FRONTEND_URL: single public base URL of the storefront (used for reset links).
# - SECURE_SSL_REDIRECT: set True in production behind HTTPS.
# - AUTH_COOKIE_SAMESITE: keep Lax unless the API is consumed cross-site (then None + HTTPS).
# - GOOGLE_CLIENT_ID: OAuth client id for Google sign-in (empty disables it).
# - OTP_EXPIRY_SECONDS / OTP_RESEND_SECONDS: OTP lifetime and resend cooldown.
# - OTP_DEBUG_CODE_ENABLED: echo OTP codes in API responses — local dev only, NEVER in prod.
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PAYMENTS_MOCK_ENABLED=False
FRONTEND_URL=http://localhost:3000
SECURE_SSL_REDIRECT=False
AUTH_COOKIE_SAMESITE=Lax
GOOGLE_CLIENT_ID=
OTP_EXPIRY_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_DEBUG_CODE_ENABLED=False

# Cache / broker (Redis). Inside docker-compose the service host is `redis`.
REDIS_URL=redis://redis:6379/0

# Notification delivery is disabled by default. Enable explicitly in production.
NOTIFICATIONS_REAL_DELIVERY_ENABLED=False
NOTIFICATIONS_EMAIL_ENABLED=False
NOTIFICATIONS_SMS_ENABLED=False
NOTIFICATIONS_MAX_ATTEMPTS=3

DEFAULT_FROM_EMAIL=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

SMS_USERNAME=
SMS_PASSWORD=
SMS_PORTAL=
# Provider-specific adapter import path; leave empty until the verified provider transport is installed.
SMS_BACKEND=
SALES_NOTIFICATION_EMAIL=
SALES_NOTIFICATION_SMS=
